{
  "name": "bio-vision",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-Footprint Virtual Dissection: browser-based anatomy education via monocular gesture recognition",
  "scripts": {
    "build:worker": "esbuild src/gesture/handWorker.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=public/handWorker.js",
    "predev": "npm run build:worker",
    "dev": "vite --port=3000 --host",
    "prebuild": "npm run build:worker",
    "build": "tsc && vite build",
    "preview": "vite preview --port=3000 --host",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  }
}
